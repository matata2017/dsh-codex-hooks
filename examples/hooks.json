{
  "description": "DSH Hooks plugin - echo demo (CODEX compatible)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/work/huanghao/dsh-hoos/examples/echo-hook.mjs\"",
            "commandWindows": "node.exe \"D:/work/huanghao/dsh-hoos/examples/echo-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "echo-hook: echoing the prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/work/huanghao/dsh-hoos/examples/echo-hook.mjs\"",
            "commandWindows": "node.exe \"D:/work/huanghao/dsh-hoos/examples/echo-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "echo-hook: inspecting the tool call"
          }
        ]
      }
    ]
  }
}
